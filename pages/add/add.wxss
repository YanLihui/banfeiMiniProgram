/* pages/add/add.wxss */
.fund-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FF8C00, #FFA500);
  margin: 24rpx 32rpx 0;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  color: white;
}
.fund-banner-icon { font-size: 36rpx; margin-right: 12rpx; }
.fund-banner-text { font-size: 28rpx; font-weight: 600; }

.type-toggle {
  display: flex;
  background: #F5F5F5;
  border-radius: 20rpx;
  margin: 24rpx 32rpx;
  padding: 6rpx;
}
.toggle-item { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 16rpx; font-size: 28rpx; color: #595959; font-weight: 500; }
.toggle-item.active-expense { background: white; color: #FF4D4F; font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1); }
.toggle-item.active-income  { background: white; color: #07C160; font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1); }

/* 金额输入 */
.amount-block { background: white; padding: 32rpx 40rpx 40rpx; border-bottom: 16rpx solid #F5F7FA; display: flex; flex-direction: column; align-items: center; }
.amount-label { font-size: 26rpx; color: #ADADAD; margin-bottom: 16rpx; }
.amount-row   { display: flex; align-items: center; gap: 8rpx; }
.amount-symbol { font-size: 44rpx; color: #D9D9D9; font-weight: 300; }
.amount-input  { font-size: 40rpx; font-weight: 800; letter-spacing: -2rpx; width: 100%; text-align: center; }
.amount-input.expense { color: #FF4D4F; }
.amount-input.income  { color: #07C160; }

/* 表单区 */
.form-section { display: flex; flex-direction: column; gap: 24rpx; padding: 24rpx 0 0; }
.form-group { background: white; border-radius: 24rpx; margin: 0 24rpx; overflow: hidden; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05); }
.group-title { font-size: 28rpx; font-weight: 700; color: #1C1C1C; }
.group-hint  { font-size: 22rpx; color: #ADADAD; }

.form-row { display: flex; align-items: center; padding: 28rpx 32rpx; gap: 16rpx; border-bottom: 1rpx solid #F5F5F5; }
.form-row:last-child { border-bottom: none; }
.fr-label { font-size: 28rpx; color: #595959; width: 128rpx; flex-shrink: 0; }
.fr-input { flex: 1; font-size: 28rpx; color: #1C1C1C; }
.fr-val   { flex: 1; font-size: 28rpx; color: #1C1C1C; }
.fr-val.ph { color: #C8C8C8; }
.fr-arrow { font-size: 28rpx; color: #D9D9D9; }
.fr-textarea { flex: 1; font-size: 28rpx; color: #1C1C1C; min-height: 80rpx; }

/* 类目选择 */
.category-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 0 32rpx 28rpx; }
.cat-chip { padding: 14rpx 28rpx; border-radius: 40rpx; font-size: 26rpx; border: 1rpx solid #E0E0E0; color: #595959; }
.cat-chip.selected { background: #E7F9EF; border-color: #07C160; color: #07C160; font-weight: 600; }

/* 图片上传 */
.upload-grid { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 0 32rpx; }
.upload-thumb { width: 160rpx; height: 160rpx; border-radius: 20rpx; overflow: hidden; position: relative; }
.thumb-img  { width: 100%; height: 100%; }
.thumb-del  { position: absolute; top: 6rpx; right: 6rpx; background: rgba(0,0,0,0.5); color: white; width: 40rpx; height: 40rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: bold; }
.upload-add { width: 160rpx; height: 160rpx; border-radius: 20rpx; border: 2rpx dashed #D9D9D9; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: #ADADAD; }
.ua-plus { font-size: 60rpx; line-height: 1; }
.ua-text  { font-size: 22rpx; }

/* 提交按钮 */
.submit-btn {
  display: block; margin: 32rpx 24rpx 0;
  border-radius: 24rpx; height: 96rpx;
  font-size: 32rpx; font-weight: 800;
  border: none;
}
.submit-btn.expense { background: #FF4D4F; color: white; box-shadow: 0 8rpx 32rpx rgba(255,77,79,0.35); }
.submit-btn.income  { background: #07C160; color: white; box-shadow: 0 8rpx 32rpx rgba(7,193,96,0.35); }
