/* pages/record/record.wxss */

/* ══ 金额头部 ══════════════════════════════════ */
.amount-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 40rpx 48rpx;
}
.amount-hero.expense {
  background: linear-gradient(155deg, #FF6B6B 0%, #FF4D4F 100%);
}
.amount-hero.income {
  background: linear-gradient(155deg, #07C160 0%, #047A3B 100%);
}
.amount-hero.claim {
  background: linear-gradient(155deg, #FFA940 0%, #FA8C16 100%);
}
.hero-icon  { font-size: 72rpx; margin-bottom: 16rpx; }
.hero-title {
  font-size: 30rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 12rpx;
}
.hero-amount {
  font-size: 80rpx;
  font-weight: 900;
  color: white;
  letter-spacing: -3rpx;
  line-height: 1;
  margin-bottom: 20rpx;
}
.hero-badge {
  background: rgba(255,255,255,0.22);
  border: 1rpx solid rgba(255,255,255,0.35);
  border-radius: 40rpx;
  padding: 6rpx 24rpx;
  font-size: 22rpx;
  color: white;
}

/* ══ 信息卡 ════════════════════════════════════ */
.info-card {
  background: white;
  border-radius: 24rpx;
  margin: 24rpx 24rpx 0;
  box-shadow: 0 2rpx 20rpx rgba(0,0,0,0.06);
  overflow: hidden;
}
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
  gap: 24rpx;
}
.info-row:last-child { border-bottom: none; }
.info-label {
  font-size: 26rpx;
  color: #ADADAD;
  flex-shrink: 0;
  width: 120rpx;
  padding-top: 2rpx;
}
.info-val {
  font-size: 28rpx;
  color: #1C1C1C;
  flex: 1;
  line-height: 1.6;
}
.info-val.notes { color: #595959; }

/* ══ 凭证图片 ══════════════════════════════════ */
.receipt-card {
  background: white;
  border-radius: 24rpx;
  margin: 16rpx 24rpx 0;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 20rpx rgba(0,0,0,0.06);
}
.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1C;
  display: block;
  margin-bottom: 20rpx;
}
.receipt-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.receipt-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #F5F5F5;
}

/* ══ Admin 操作 ════════════════════════════════ */
.action-area {
  margin: 24rpx 24rpx 0;
}
.del-btn {
  text-align: center;
  background: white;
  border: 1rpx solid #FFCCC7;
  color: #FF4D4F;
  border-radius: 24rpx;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(255,77,79,0.08);
}
.reimburse-btn {
  text-align: center;
  background: #07C160;
  color: white;
  border-radius: 24rpx;
  padding: 32rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(7,193,96,0.3);
}
.reimburse-btn.disabled { opacity: 0.6; }
.claim-action-row {
  display: flex;
  gap: 20rpx;
}
.claim-btn {
  flex: 1;
  text-align: center;
  padding: 32rpx 0;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
}
.claim-btn.approve { background: #07C160; color: white; }
.claim-btn.reject  { background: white; border: 1rpx solid #FFCCC7; color: #FF4D4F; }

/* ══ 报销状态标签 ════════════════════════════════ */
.status-badge {
  font-size: 24rpx; font-weight: 600;
  padding: 4rpx 16rpx; border-radius: 40rpx;
}
.status-badge.reimbursed   { background: #F6FFED; color: #52C41A; border: 1rpx solid #B7EB8F; }
.status-badge.unreimbursed { background: #FFF7E6; color: #FA8C16; border: 1rpx solid #FFD591; }

.loading-wrap {
  display: flex;
  justify-content: center;
}
