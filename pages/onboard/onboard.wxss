/* pages/onboard/onboard.wxss */

/* ══ 顶部品牌 ══════════════════════════════════ */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
  background: linear-gradient(155deg, #07C160 0%, #047A3B 100%);
}
.hero-emoji  { font-size: 96rpx; margin-bottom: 16rpx; }
.hero-title  { font-size: 52rpx; font-weight: 900; color: white; letter-spacing: 4rpx; }
.hero-sub    { font-size: 26rpx; color: rgba(255,255,255,0.75); margin-top: 12rpx; }

/* ══ 表单卡片 ══════════════════════════════════ */
.form-card {
  background: white;
  border-radius: 32rpx 32rpx 0 0;
  margin-top: -32rpx;
  padding: 48rpx 40rpx 60rpx;
  min-height: 100vh;
}
.form-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1C1C1C;
  display: block;
  margin-bottom: 48rpx;
}

/* ══ 头像 ══════════════════════════════════════ */
.avatar-row {
  display: flex;
  justify-content: center;
  margin-bottom: 48rpx;
}
.avatar-btn {
  background: none;
  padding: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  position: relative;
  line-height: 1;
}
.avatar-btn::after { border: none; }
.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: block;
}
.avatar-edit-tag {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: rgba(0,0,0,0.45);
  color: white;
  font-size: 20rpx;
  text-align: center;
  padding: 6rpx 0;
  border-radius: 0 0 80rpx 80rpx;
}

/* ══ 表单字段 ══════════════════════════════════ */
.field {
  margin-bottom: 32rpx;
}
.field-label {
  font-size: 26rpx;
  color: #8C8C8C;
  display: block;
  margin-bottom: 12rpx;
}
.required-star { color: #FF4D4F; }
.field-input {
  width: 100%;
  height: 96rpx;
  background: #F7F8FA;
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #1C1C1C;
  box-sizing: border-box;
}

/* ══ 提示 ══════════════════════════════════════ */
.not-found-tip {
  background: #FFF2F0;
  border: 1rpx solid #FFCCC7;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: #FF4D4F;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.chair-claim-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.chair-claim-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.chair-claim-text {
  font-size: 28rpx;
  color: #595959;
}
.input-error {
  border: 1rpx solid #FF4D4F !important;
  background: #FFF2F0 !important;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
}
.picker-val  { font-size: 30rpx; color: #1C1C1C; }
.picker-ph   { font-size: 30rpx; color: #C0C0C0; }
.picker-arrow { font-size: 36rpx; color: #C0C0C0; }

.field-input-wrap {
  position: relative;
}
.fake-placeholder {
  position: absolute;
  top: 0; left: 28rpx;
  height: 96rpx; line-height: 96rpx;
  font-size: 30rpx; color: #C0C0C0;
  pointer-events: none;
}
.field-hint {
  font-size: 22rpx;
  color: #ADADAD;
  display: block;
  margin-top: 8rpx;
  line-height: 1.5;
}
.hint {
  font-size: 22rpx;
  color: #ADADAD;
  display: block;
  margin-bottom: 48rpx;
  line-height: 1.6;
}

/* ══ 提交按钮 ══════════════════════════════════ */
.submit-btn {
  width: 100%;
  height: 100rpx;
  background: #07C160;
  color: white;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}
.submit-btn.disabled { opacity: 0.6; }
