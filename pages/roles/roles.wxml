<!-- pages/roles/roles.wxml -->
<view class="container">

  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-tip">加载中...</text>
  </view>

  <block wx:else>
    <view class="tip-bar">
      <text class="tip-text">点击成员可修改角色。成员需先扫码完成注册才会出现在列表中。</text>
    </view>

    <view wx:if="{{members.length === 0}}" class="empty-state">
      <text class="empty-icon">👥</text>
      <text class="empty-text">暂无已注册成员</text>
    </view>

    <view class="member-list" wx:else>
      <view
        class="member-item"
        wx:for="{{members}}"
        wx:key="openid"
        bindtap="pickRole"
        data-index="{{index}}"
      >
        <!-- 头像 -->
        <view class="avatar">
          <text class="avatar-text">{{item.initial}}</text>
        </view>

        <!-- 信息 -->
        <view class="member-info">
          <view class="member-name-row">
            <text class="member-name">{{item.name}}</text>
            <view class="role-tag {{item.role === 'parent' ? 'parent' : item.role === 'artDirector' ? 'art' : item.role === 'planningDirector' ? 'planning' : 'committee'}}">
              <text>{{item.roleLabel}}</text>
            </view>
          </view>
          <text class="member-child">孩子：{{item.childName}}</text>
        </view>

        <!-- 编辑箭头 -->
        <text class="arrow">›</text>
      </view>
    </view>
  </block>

  <view class="safe-bottom"></view>
</view>

<!-- 自定义角色选择面板 -->
<view wx:if="{{showRolePicker}}" class="picker-mask" bindtap="onPickerMaskTap"></view>
<view class="picker-sheet {{showRolePicker ? 'visible' : ''}}">
  <view class="picker-title">选择角色</view>
  <view
    class="picker-option {{roleOptions[index].value === (members[pickerIndex] && members[pickerIndex].role) ? 'current' : ''}}"
    wx:for="{{roleOptions}}"
    wx:key="value"
    bindtap="selectRole"
    data-role="{{item.value}}"
  >
    <text class="picker-option-label">{{item.label}}</text>
    <text wx:if="{{item.value === (members[pickerIndex] && members[pickerIndex].role)}}" class="picker-check">✓</text>
  </view>
  <view class="picker-cancel" bindtap="closeRolePicker">取消</view>
</view>
