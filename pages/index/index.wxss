/* pages/index/index.wxss */

/* ══ 缴费横幅 ════════════════════════════════ */
.pay-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
}
.pay-banner.unpaid {
  background: #FFF7E6;
  border: 1rpx solid #FFD591;
  justify-content: space-between;
}
.pay-banner.pending {
  background: #E6F7FF;
  border: 1rpx solid #91D5FF;
}
.pay-banner.paid {
  background: #E7F9EF;
  border: 1rpx solid #B7EB8F;
}
.pay-banner-icon { font-size: 36rpx; flex-shrink: 0; }
.pay-banner-left  { display: flex; flex-direction: column; gap: 4rpx; flex: 1; }
.pay-banner-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1C;
}
.pay-banner.pending .pay-banner-title { color: #0050B3; }
.pay-banner.paid    .pay-banner-title { color: #237804; }
.pay-banner-sub { font-size: 22rpx; color: #8C8C8C; }
.pay-banner-btn {
  background: #FA8C16;
  color: white;
  font-size: 26rpx;
  font-weight: 700;
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}
.pay-banner-btn.disabled { opacity: 0.6; }

/* ══ 英雄区 ══════════════════════════════════ */
.hero {
  background: linear-gradient(155deg, #07C160 0%, #059A4A 55%, #047A3B 100%);
  padding-bottom: 36rpx;
  position: relative;
  overflow: hidden;
}
/* 装饰圆 */
.hero::before {
  content: '';
  position: absolute;
  top: -80rpx; right: -80rpx;
  width: 360rpx; height: 360rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
}
.hero::after {
  content: '';
  position: absolute;
  bottom: -120rpx; left: 80rpx;
  width: 300rpx; height: 300rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 40rpx 0;
  position: relative; z-index: 1;
}
.nav-left { display: flex; flex-direction: column; }
.nav-class { font-size: 32rpx; font-weight: 800; color: white; }
.nav-term-row {
  display: flex; align-items: center; gap: 8rpx; margin-top: 4rpx;
}
.nav-term  { font-size: 24rpx; color: rgba(255,255,255,0.7); }
.nav-term-arrow { font-size: 20rpx; color: rgba(255,255,255,0.5); }
.nav-bell  { font-size: 44rpx; }

/* 历史学年提示条 */
.history-bar {
  display: flex; align-items: center; justify-content: space-between;
  margin: 16rpx 24rpx 0;
  padding: 14rpx 24rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  position: relative; z-index: 1;
}
.history-bar-text { font-size: 24rpx; color: rgba(255,255,255,0.9); }
.history-bar-btn  { font-size: 22rpx; color: white; font-weight: 600; }

/* 余额 */
.balance-area {
  padding: 28rpx 40rpx 0;
  position: relative; z-index: 1;
}
.balance-split-row { display: flex; align-items: flex-start; }
.balance-split-item { flex: 1; }
.balance-vdivider {
  width: 1rpx; background: rgba(255,255,255,0.3);
  margin: 10rpx 28rpx 0; align-self: stretch;
}
.balance-label { font-size: 24rpx; color: rgba(255,255,255,0.75); display: block; margin-bottom: 6rpx; }
.balance-row   { display: flex; align-items: flex-end; gap: 2rpx; }
.balance-symbol { font-size: 30rpx; font-weight: 300; color: rgba(255,255,255,0.9); margin-bottom: 6rpx; }
.balance-value  { font-size: 64rpx; font-weight: 900; color: white; letter-spacing: -3rpx; line-height: 1; }

/* 统计行 */
.stats-row {
  display: flex;
  margin: 36rpx 32rpx 0;
  background: rgba(255,255,255,0.13);
  border-radius: 24rpx;
  overflow: hidden;
  position: relative; z-index: 1;
}
.stat-cell  { flex: 1; padding: 24rpx 32rpx; }
.stat-label { font-size: 24rpx; color: rgba(255,255,255,0.72); display: block; margin-bottom: 6rpx; }
.stat-value { font-size: 26rpx; font-weight: 800; color: white; display: block; letter-spacing: -1rpx; }
.stat-sub   { font-size: 20rpx; color: rgba(255,255,255,0.6); display: block; margin-top: 4rpx; }
.stat-divider { width: 1rpx; background: rgba(255,255,255,0.2); margin: 20rpx 0; }

/* ══ 通用 section-card ══════════════════════ */
.section-card {
  background: white;
  border-radius: 24rpx;
  margin: 24rpx 24rpx 0;
  box-shadow: 0 2rpx 20rpx rgba(0,0,0,0.06);
  overflow: hidden;
}

/* ══ 进度条区 ════════════════════════════════ */
.progress-card { padding: 28rpx 32rpx; }
.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.progress-count { font-size: 26rpx; font-weight: 700; }
.progress-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

/* ══ 快捷操作 ════════════════════════════════ */
.quick-actions {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 0 4rpx;
}
.action-btn {
  width: 25%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 4rpx 16rpx;
}
.action-icon {
  width: 96rpx; height: 96rpx;
  border-radius: 28rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
}
.action-icon.green  { background: #E7F9EF; }
.action-icon.orange { background: #FFF7E6; }
.action-icon.pink   { background: #FFF0F6; }
.action-icon.blue   { background: #EBF5FF; }
.action-icon.purple { background: #F5F0FF; }
.action-icon.gray   { background: #F5F5F5; }
.action-icon.teal   { background: #E6FFFB; }
.action-label { font-size: 22rpx; color: #595959; font-weight: 500; text-align: center; }

/* ══ 最近记录 ════════════════════════════════ */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 32rpx 16rpx;
}
.section-title { font-size: 30rpx; font-weight: 800; color: #1C1C1C; }
.section-more  { font-size: 26rpx; color: #ADADAD; }

.tx-list { padding: 0; }

.tx-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  gap: 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.tx-item:last-child { border-bottom: none; }

/* 图标背景 */
.tx-icon-wrap {
  width: 84rpx; height: 84rpx;
  border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.tx-icon { font-size: 40rpx; }
.bg-pink        { background: #FFF0F6; }
.bg-orange      { background: #FFF7E6; }
.bg-purple      { background: #F5F0FF; }
.bg-green       { background: #E7F9EF; }
.bg-green-light { background: #E7F9EF; }
.bg-blue        { background: #EBF5FF; }
.bg-gray        { background: #F5F5F5; }

.tx-body { flex: 1; min-width: 0; }
.tx-name {
  font-size: 28rpx; font-weight: 500; color: #1C1C1C;
  display: block;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.tx-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 6rpx; }
.tx-date { font-size: 22rpx; color: #ADADAD; }
.receipt-badge {
  background: #F0F0F0;
  color: #888;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
}
.tx-amount { font-size: 30rpx; font-weight: 800; flex-shrink: 0; }
.tx-amount.expense { color: #FF4D4F; }
.tx-amount.income  { color: #07C160; }
.tx-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; flex-shrink: 0; }
.tag-unreimbursed { font-size: 18rpx; color: #FA8C16; background: #FFF7E6; border: 1rpx solid #FFD591; border-radius: 8rpx; padding: 2rpx 8rpx; }
.tag-reimbursed   { font-size: 18rpx; color: #52C41A; background: #F6FFED; border: 1rpx solid #B7EB8F; border-radius: 8rpx; padding: 2rpx 8rpx; }

/* ══ 公告栏 ════════════════════════════════ */
.notice-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #FFFBE6;
  border: 1rpx solid #FFE58F;
  border-radius: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
}
.notice-editable { border-style: dashed; }
.notice-icon { font-size: 32rpx; flex-shrink: 0; margin-top: 2rpx; }
.notice-text { font-size: 26rpx; color: #7C5E00; line-height: 1.6; }
.notice-edit-hint { font-size: 20rpx; color: #ADADAD; flex-shrink: 0; align-self: center; }

/* ══ 公告编辑弹窗 ═══════════════════════════ */
.notice-editor-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex; align-items: flex-end;
  z-index: 200;
}
.notice-editor-card {
  width: 100%; background: white;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 40rpx 60rpx;
  box-sizing: border-box;
}
.notice-editor-title {
  display: block; font-size: 32rpx; font-weight: 700;
  color: #1C1C1C; margin-bottom: 24rpx; text-align: center;
}
.notice-editor-textarea {
  width: 100%; min-height: 200rpx;
  background: #F7F8FA; border-radius: 16rpx;
  padding: 24rpx; font-size: 28rpx; color: #1C1C1C;
  line-height: 1.7; box-sizing: border-box;
}
.notice-editor-count {
  display: block; text-align: right;
  font-size: 22rpx; color: #ADADAD; margin-top: 8rpx;
}
.notice-editor-btns {
  display: flex; gap: 20rpx; margin-top: 32rpx;
}
.notice-editor-btn {
  flex: 1; text-align: center;
  padding: 28rpx 0; border-radius: 20rpx;
  font-size: 30rpx; font-weight: 600;
}
.notice-editor-btn.cancel  { background: #F5F5F5; color: #8C8C8C; }
.notice-editor-btn.confirm { background: #07C160; color: white; }
.notice-editor-btn.disabled { opacity: 0.5; }

/* ══ 无权限 / 新用户引导 ══════════════════════ */
.blocked-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 60rpx;
  gap: 24rpx;
}
.blocked-icon  { font-size: 100rpx; }
.blocked-title { font-size: 36rpx; font-weight: 700; color: #1C1C1C; }
.blocked-sub   { font-size: 26rpx; color: #8C8C8C; text-align: center; line-height: 1.6; }
.blocked-btn {
  margin-top: 16rpx;
  background: #07C160; color: white;
  font-size: 28rpx; font-weight: 600;
  padding: 24rpx 60rpx; border-radius: 40rpx;
}

/* ══ 花名册未导入提示 ══════════════════════════ */
.roster-tip {
  display: flex; align-items: center; gap: 20rpx;
  margin: 0 24rpx 16rpx;
  background: #FFFBE6; border: 1rpx solid #FFE58F;
  border-radius: 20rpx; padding: 24rpx 28rpx;
}
.roster-tip-icon { font-size: 40rpx; flex-shrink: 0; }
.roster-tip-body { flex: 1; }
.roster-tip-title { font-size: 28rpx; font-weight: 700; color: #874D00; display: block; }
.roster-tip-sub   { font-size: 22rpx; color: #AD6800; display: block; margin-top: 4rpx; }
.roster-tip-arrow { font-size: 40rpx; color: #FA8C16; }

